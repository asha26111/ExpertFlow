# ─── Copy to .env and fill in values ──────────────────────────────────────────

# Option A: SQLite (no setup needed — great for development)
DATABASE_URL=sqlite:///./data/deepseek_edu.db

# Option B: PostgreSQL (for production)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/deepseek_edu

# JWT Secret — change in production
SECRET_KEY=super-secret-key-change-this-in-production-minimum-32-chars!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# DeepSeek API key — get it at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Local storage directories (auto-created)
CHROMA_PERSIST_DIR=./chroma_db
APP_NAME=DeepSeek EDU
DEBUG=True
